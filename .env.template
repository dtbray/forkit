# forkit environment configuration
# Copy to .env and fill in values before running.
# Never commit .env to version control.

# ── HermitHost / Traefik ───────────────────────────────────────────────────────

# Network mode: "lan" (Traefik routes internally) or "wan" (external SSL).
# WAN mode requires FORKIT_AUTH_MODE to be set to "acknowledge_wan_exposed".
HERMITHOST_PORT_MODE=lan

# Fully qualified domain name used by Traefik to route requests to forkit.
SERVICE_FQDN_FRONTEND=forkit.hh

# ── Data Paths (inside container volume) ──────────────────────────────────────

# SQLite database file location.
FORKIT_DB_PATH=/data/forkit.db

# Directory where recipe images are stored.
FORKIT_IMAGE_DIR=/data/images

# ── LLM Provider ──────────────────────────────────────────────────────────────

# Active LLM provider: "ollama" or "anthropic"
FORKIT_LLM_PROVIDER=ollama

# Base URL for the Ollama inference server (used when FORKIT_LLM_PROVIDER=ollama).
FORKIT_OLLAMA_BASE_URL=http://localhost:11434

# Anthropic API key (used when FORKIT_LLM_PROVIDER=anthropic).
# Leave blank when using Ollama.
FORKIT_ANTHROPIC_API_KEY=

# ── Suggestion Engine ─────────────────────────────────────────────────────────

# Optional JSON override for suggestion ranking weights.
# Uncomment and adjust to tune the recommendation algorithm.
# FORKIT_SUGGESTION_WEIGHTS={"recency":0.4,"cook_norm":0.3,"rating":0.2,"new_bonus":0.1}
